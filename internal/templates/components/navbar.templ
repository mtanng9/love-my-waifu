</div>
    <hr class="bg-[#f472b6] border-0 h-px">


<div class="navbar bg-base-100 shadow-sm bg-[#fff0f6]">
  <div class="flex-1">
    <a class="btn btn-ghost text-xl text-[#f472b6]">Love My Waifu</a>
